generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  digital
  physical
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  paid
  pending
  failed
  refunded
}

enum CustomerStatus {
  active
  vip
  inactive
}

enum DiscountType {
  percentage
  fixed
}

model Category {
  id          String    @id
  name        String
  slug        String    @unique
  description String
  image       String
  itemCount   Int       @default(0)
  featured    Boolean   @default(false)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String       @id
  title           String
  slug            String       @unique
  type            ProductType
  description     String
  shortDescription String
  price           Decimal      @db.Decimal(10, 2)
  compareAtPrice  Decimal?     @db.Decimal(10, 2)
  costPrice       Decimal?     @db.Decimal(10, 2)
  rating          Float        @default(0)
  reviewCount     Int          @default(0)
  sku             String       @unique
  stock           Int          @default(0)

  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])

  subcategory    String?
  tags           String[]
  images         String[]

  isFeatured     Boolean      @default(false)
  isTrending     Boolean      @default(false)
  isNewArrival   Boolean      @default(false)

  sizes          String[]
  specifications Json?

  physicalDetails PhysicalProductDetails?
  digitalDetails  DigitalProductDetails?
  colors          ProductColor[]
  reviews         Review[]
  orderItems      OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoryId])
  @@index([type])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([isNewArrival])
}

model ProductColor {
  id        String   @id @default(cuid())
  name      String
  hex       String
  inStock   Boolean  @default(true)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model DigitalProductDetails {
  id            String   @id @default(cuid())
  format        String
  fileSize      String?
  deliveryMethod String?
  license       String?
  previewUrl    String?

  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PhysicalProductDetails {
  id          String   @id @default(cuid())
  weight      String?
  dimensions  String?
  shippingClass String?

  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String         @id
  name          String
  email         String         @unique
  phone         String
  avatar        String?
  joinedDate    DateTime       @default(now())
  totalOrders   Int            @default(0)
  totalSpent    Decimal        @default(0) @db.Decimal(10, 2)
  status        CustomerStatus @default(active)

  addresses     Address[]
  orders        Order[]
  reviews       Review[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  phone        String

  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model Order {
  id                 String        @id
  orderNumber        String        @unique
  date               DateTime      @default(now())

  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items              OrderItem[]

  subtotal           Decimal       @db.Decimal(10, 2)
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(10, 2)
  tax                Decimal       @default(0) @db.Decimal(10, 2)
  total              Decimal       @db.Decimal(10, 2)

  appliedPromoCode   String?
  paymentMethod      String
  paymentStatus      PaymentStatus @default(pending)
  fulfillmentStatus  OrderStatus   @default(pending)

  trackingNumber     String?
  trackingCarrier    String?
  estimatedDeliveryDate DateTime?
  notes              String?

  shippingAddress    Json
  billingAddress     Json?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([customerId])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([date])
}

model OrderItem {
  id             String   @id @default(cuid())

  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  title          String
  price          Decimal  @db.Decimal(10, 2)
  image          String
  selectedColor  String?
  selectedSize   String?
  quantity       Int
  isDigital      Boolean  @default(false)
  downloadUrl    String?

  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Review {
  id             String   @id @default(cuid())

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  author         String
  rating         Int
  title          String
  comment        String
  date           DateTime @default(now())
  verifiedPurchase Boolean @default(false)
  helpfulCount   Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([customerId])
}

model DiscountCode {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minPurchase   Decimal?     @db.Decimal(10, 2)
  description   String

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}